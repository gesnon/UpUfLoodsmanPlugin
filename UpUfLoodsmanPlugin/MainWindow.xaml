<Window x:Class="UpUfLoodsmanPlugin.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:UpUfLoodsmanPlugin"        
        mc:Ignorable="d"
        Title="Создание управляющих программ из чертежа" Height="758" Width="1160">

    <Grid Margin="15,15,15,15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Border BorderBrush="Black" BorderThickness="1" Background="White" Height="54" Grid.RowSpan="1"/>
        <Border BorderBrush="Black" BorderThickness="1" Background="White" Grid.Row="1" Margin="0,15,0,15" Padding="5,5,5,5">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Border BorderBrush="Black" BorderThickness="1" Width="150" Padding="5,5,5,5">
                    <ListBox x:Name="ListBox1" d:ItemsSource="{d:SampleData ItemCount=5}" SelectionMode="Multiple" Background="#FFA5A2A2">
                        <ListBox.ItemContainerStyle>
                            <Style/>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                </Border>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="1" Margin="5,0,5,0"/>
                <Border BorderBrush="Black" BorderThickness="1" Grid.Column="2">
                    <ListView x:Name="myListView" ItemsSource="{Binding anyList}">
                        <ListView.ItemContainerStyle>
                            <Style TargetType="ListViewItem">
                                <Style.Triggers>
                                    <!-- Если статус Done — цвет зеленый -->
                                    <DataTrigger Binding="{Binding OperationStatus}" Value="Waiting">
                                        <Setter Property="Background" Value="LightYellow"/>
                                    </DataTrigger>
                                    <!-- Если статус InProgress — цвет желтый -->
                                    <DataTrigger Binding="{Binding OperationStatus}" Value="Success">
                                        <Setter Property="Background" Value="LightGreen"/>
                                    </DataTrigger>
                                    <!-- Если статус InProgress — цвет желтый -->
                                    <DataTrigger Binding="{Binding OperationStatus}" Value="Unsuccess">
                                        <Setter Property="Background" Value="IndianRed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ListView.ItemContainerStyle>

                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Задача" DisplayMemberBinding="{Binding Name}" Width="200" >

                                </GridViewColumn>
                                <GridViewColumn Header="Статус" DisplayMemberBinding="{Binding OperationStatus}" Width="100"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Border>
            </Grid>
        </Border>
        <Border BorderBrush="Black" BorderThickness="1" Background="White" Grid.Row="2" Height="54">
            <Button x:Name="mainButton" Content="Button" Click="mainButton_Click"/>
        </Border>


    </Grid>
</Window>
